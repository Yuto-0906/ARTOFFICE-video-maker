{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARTOFFICE広報動画作成ソフト",
  "version": "0.1.0",
  "identifier": "com.yuto0906.artoffice-video-maker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARTOFFICE広報動画作成ソフト",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "copyright": "Copyright © 2026 ARTOFFICE",
    "category": "Video",
    "shortDescription": "ライブ動画のトリミング・結合・チャプター作成"
  }
}
